#!/usr/bin/env bash
set -euo pipefail

cd "${NITESHIFT_CHECKOUT_ROOT:?}/book-analyzer-app"

# Keep cached installs when the dependency inputs and runtime are unchanged.
frontend_key="$( { sha256sum frontend/package.json frontend/package-lock.json; node --version; } | sha256sum | cut -d ' ' -f 1)"
if [[ ! -x frontend/node_modules/.bin/vite || ! -x frontend/node_modules/.bin/tailwindcss || "$(cat frontend/node_modules/.niteshift-dependencies 2>/dev/null || true)" != "$frontend_key" ]]; then
  (cd frontend && npm ci --no-audit --no-fund)
  echo "$frontend_key" > frontend/node_modules/.niteshift-dependencies
fi

if ! command -v uv >/dev/null; then
  python3 -m pip install uv
fi
if [[ ! -x backend/venv/bin/python ]]; then
  uv venv --python python3 backend/venv
fi
backend_key="$( { sha256sum backend/pyproject.toml backend/requirements.txt; backend/venv/bin/python --version; } | sha256sum | cut -d ' ' -f 1)"
if [[ ! -x backend/venv/bin/flask || "$(cat backend/venv/.niteshift-dependencies 2>/dev/null || true)" != "$backend_key" ]]; then
  uv pip install --python backend/venv/bin/python -r backend/requirements.txt -e './backend[dev]'
  echo "$backend_key" > backend/venv/.niteshift-dependencies
fi

# The HTML loads this generated stylesheet before the watcher starts.
(cd frontend && npm run tw:build)
